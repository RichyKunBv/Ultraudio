<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ultraudio.Views.Windows.LogsWindow"
        Title="Registro de Actividad y Reporte de Errores"
        Width="700" Height="520"
        MinWidth="550" MinHeight="400"
        Background="#0F0F0F"
        WindowStartupLocation="CenterOwner"
        Icon="avares://Ultraudio/Assets/icon.ico">

    <Window.Styles>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.5"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#333333"/>
        </Style>
        <Style Selector="Button.report-git">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.report-git:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2EA043"/>
        </Style>
        <Style Selector="Button.report-mail">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.report-mail:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#388BFD"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">

        <!-- Top Header & Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,12" RowDefinitions="Auto,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Registro y Reporte de Errores" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Supervisión de eventos internos y herramientas de diagnóstico" FontSize="11" Foreground="#777777"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="BtnCopiar" Classes="action-btn" Content="📋 Copiar Logs" Click="BtnCopiar_Click"/>
                    <Button Name="BtnAbrirCarpeta" Classes="action-btn" Content="📁 Abrir Carpeta" Click="BtnAbrirCarpeta_Click"/>
                    <Button Name="BtnLimpiar" Classes="action-btn" Content="🗑️ Limpiar" Click="BtnLimpiar_Click"/>
                </StackPanel>
            </Grid>

            <!-- Search / Filter -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Name="TxtFiltro" Background="#161616" Foreground="#CCCCCC"
                         BorderBrush="#2A2A2A" CornerRadius="6" Padding="10,6" FontSize="12"
                         PlaceholderText="🔍 Filtrar registros (ej: AudioEngine, ERROR, BASS)..."
                         TextChanged="TxtFiltro_TextChanged"/>
                <TextBlock Grid.Column="1" Name="TxtLogStats" Text="0 líneas" Foreground="#666666"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Grid>

        <!-- Log Content Display -->
        <Border Grid.Row="1" Background="#080808" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Padding="8">
            <TextBox Name="TxtLogs"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     Background="Transparent"
                     Foreground="#00E576"
                     FontFamily="Cascadia Code,Consolas,Courier New,Monospace"
                     FontSize="11"
                     BorderThickness="0"/>
        </Border>

        <!-- Bottom Error Reporting Section -->
        <Border Grid.Row="2" Background="#141414" BorderBrush="#222222" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="REPORTAR PROBLEMA O ERROR" Classes="header"/>
                    <TextBlock Text="Envía tu diagnóstico directamente al desarrollador" FontSize="11" Foreground="#888888" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Button 1: GitHub Issues -->
                <Button Grid.Column="1" Name="BtnReportGit" Classes="report-git"
                        Content="🐙 GitHub Issues" ToolTip.Tip="Crear nuevo Issue en GitHub con diagnóstico"
                        Click="BtnReportGit_Click" Margin="0,0,10,0"/>

                <!-- Button 2: Correo -->
                <Button Grid.Column="2" Name="BtnReportEmail" Classes="report-mail"
                        Content="✉️ Enviar Correo" ToolTip.Tip="Enviar reporte de error por correo electrónico"
                        Click="BtnReportEmail_Click" Margin="0,0,10,0"/>

                <!-- Close -->
                <Button Grid.Column="3" Name="BtnCerrar" Classes="action-btn"
                        Content="Cerrar" Click="BtnCerrar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
